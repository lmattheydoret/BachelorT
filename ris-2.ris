UR  - https://basel.swisscovery.org/openurl/41SLSP_UBS/41SLSP_UBS:live?sid=OVID:embase&id=pmid:24882551&id=doi:10.1016%2Fj.euroneuro.2014.04.008&issn=0924-977X&isbn=&volume=24&issue=8&spage=1371&pages=1371-1380&date=2014&title=European+Neuropsychopharmacology&atitle=Pay+attention+to+impulsivity%3A+Modelling+low+attentive+and+high+impulsive+subtypes+of+adult+ADHD+in+the+5-choice+continuous+performance+task+%285C-CPT%29+in+female+rats&aulast=Tomlinson&pid=%3Cauthor%3ETomlinson+A.%3BGrayson+B.%3BMarsh+S.%3BHarte+M.K.%3BBarnes+S.A.%3BMarshall+K.M.%3BNeill+J.C.%3C%2Fauthor%3E%3CAN%3E53149048%3C%2FAN%3E%3CDT%3EArticle%3C%2FDT%3E
